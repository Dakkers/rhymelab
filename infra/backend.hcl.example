# Copy to `backend.hcl` (gitignored), fill in your R2 account id + bucket, then:
#   terraform init -backend-config=backend.hcl
#
# R2 credentials come from the environment, NOT this file:
#   export AWS_ACCESS_KEY_ID=<r2-access-key-id>
#   export AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>

bucket    = "rhymelab-tfstate"
key       = "infra/terraform.tfstate"
region    = "auto"
endpoints = { s3 = "https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com" }

# R2 quirks vs real S3 — leave these as-is.
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_s3_checksum            = true
use_path_style              = true
