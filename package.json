{
  "name": "rhymelab",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "app/frontend/*",
    "app/backend/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev:seed": "pnpm --filter @rhymelab/api dev:db:seed",
    "dev:web": "pnpm --filter @rhymelab/web dev",
    "dev:api": "pnpm --filter @rhymelab/api dev",
    "build:web": "pnpm --filter @rhymelab/web build",
    "build:api": "pnpm --filter @rhymelab/api build",
    "start:web": "pnpm --filter @rhymelab/web start",
    "start:api": "pnpm --filter @rhymelab/api start",
    "sandbox": "./rhymelab-sandbox",
    "cf-typegen": "pnpm --filter @rhymelab/web cf-typegen",
    "db:generate": "pnpm --filter @rhymelab/database build",
    "db:migrate": "pnpm --filter @rhymelab/database migrate",
    "db:studio": "pnpm --filter @rhymelab/database studio",
    "test:unit": "pnpm --filter @rhymelab/core --filter @rhymelab/api test",
    "test:integration": "pnpm --filter @rhymelab/api test:integration",
    "typecheck": "pnpm -r typecheck",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "oxfmt": "0.50.0",
    "oxlint": "1.64.0",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.22.0"
}
