# Build context for the API image (app/backend/api/Dockerfile, context = repo
# root). Keep the context lean and keep secrets out of the image.

# VCS / tooling
.git
.github
.claude
.changeset
.dummy

# Dependencies — reinstalled inside the image
**/node_modules

# Build outputs / caches
**/dist
**/.wrangler
**/coverage
**/test-results
**/playwright-report
**/*.tsbuildinfo

# Generated Prisma client — regenerated inside the image
app/backend/api/src/_generated

# Local env files — never bake into the image; Render provides real env vars.
# (Also keeps the committed localhost/dev defaults in .config/.env — including
# APP_PASSWORD="password" — from silently shadowing production values: a var the
# host forgets to set then fails loudly instead of falling back to a dev value.)
app/backend/api/.config/.env
app/backend/api/.config/.env.*
app/frontend/web/.config/.env
app/frontend/web/.config/.env.*
**/*.local

# Dev-only tooling not needed in the app image
sandbox
compose.yaml
infra

# Docs
**/*.md
