# Local secrets for `pnpm dev`, loaded into the Worker by @cloudflare/vite-plugin.
# Copy this file to `.dev.vars` and fill in real values. `.dev.vars` is gitignored
# — never commit it.
#
# The app runs without these (it falls back to insecure dev defaults and prints a
# warning), but set them to exercise the real login flow.

# Signs the session cookie. Use a long random string (>= 32 characters).
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# The shared password the demo login checks against.
APP_PASSWORD=password
