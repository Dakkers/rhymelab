# Shared defaults for every mode (committed — do NOT put secrets here).
#
# Vite loads, in increasing priority: .env -> .env.local -> .env.[mode] ->
# .env.[mode].local. Values here are the base every mode inherits.
#
# Only variables prefixed with VITE_ are exposed to client code. Secrets belong
# in .dev.vars (local Worker runtime) or `wrangler secret put` (deployed).

VITE_APP_NAME=react-ssr

# Base URL of the oRPC API (@rhymelab/api). The web app's data + auth all go here.
VITE_API_URL=http://localhost:4000/rpc
