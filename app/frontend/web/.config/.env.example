# Reference for the env files this package uses. Nothing loads *this* file —
# it's documentation plus a starting point to copy from.
#
# These live in .config/ rather than the package root because vite.config.ts
# sets `envDir: ".config"`.
#
# Vite reads four files, in INCREASING priority (later wins — note this is the
# opposite order from the API package's loader):
#
#   1. .env                  committed  — shared defaults for every mode
#   2. .env.local            gitignored — your overrides for every mode
#   3. .env.<mode>           committed  — non-secret per-mode defaults
#   4. .env.<mode>.local     gitignored — your overrides for one mode
#
# A variable exported in your shell beats all four.
#
# The mode comes from the command, not from NODE_ENV:
#
#   pnpm dev                     -> development
#   pnpm build / pnpm deploy     -> production   (Vite's default build mode)
#   vite build --mode staging    -> staging
#
# Which files exist:
#
#   COMMITTED (in git, never put a real secret in these)
#     .env                     shared defaults
#     .env.development
#     .env.staging
#     .env.production
#
#   GITIGNORED (not in a fresh clone — create the one you need by hand)
#     .env.local
#     .env.development.local
#     .env.staging.local
#     .env.production.local
#
# ─── Secrets do NOT go in any of these ───────────────────────────────────────
#
# Only VITE_-prefixed variables are exposed to client code, and anything exposed
# to client code ships in the browser bundle where it is readable by anyone. So
# a VITE_ variable is never a secret, no matter which file it sits in.
#
# Server-side secrets belong to the Worker instead: put them in .dev.vars for
# local runs, and use `wrangler secret put <NAME>` for deployed environments.

# ─── The variables, with copy-paste-ready dev values ─────────────────────────

# Set in .env, so every mode inherits it. Nothing reads it today — it's a
# leftover from the starter template.
VITE_APP_NAME=react-ssr

# Base URL of the oRPC API (@rhymelab/api). The web app's data + auth all go
# here — see src/lib/orpc.ts, the one place it's read. Override in
# .env.development.local when the API runs on a non-default port, e.g. a
# worktree with its own ports.
VITE_API_URL=http://localhost:4000/rpc

# Names the current environment. Each committed .env.<mode> sets this to its own
# mode name. Nothing reads it today; it's there for when something needs to
# branch on the environment.
VITE_APP_ENV=development
