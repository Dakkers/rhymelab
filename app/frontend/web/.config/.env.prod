# Production environment defaults (committed — do NOT put secrets here).
# Loaded when the mode is "prod": `vite build --mode prod`. Note that Vite's
# default mode for `vite build` is "production", so pass `--mode prod`
# explicitly (or rename this file to .env.production) for it to apply.
#
# Vite exposes variables prefixed with VITE_ to client code. Secrets belong in
# Worker secrets (`wrangler secret put <NAME>`) instead.

VITE_APP_ENV=prod
