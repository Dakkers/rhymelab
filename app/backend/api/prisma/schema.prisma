// RhymeLab's data model.
//
// The product tables (entries / sections / annotations) were removed while the
// UX — and with it the data model — is redesigned from the ground up. Only the
// Prisma/Postgres plumbing is kept: add the new models here, then run
// `pnpm db:migrate` to regenerate the client and the migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/_generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}
