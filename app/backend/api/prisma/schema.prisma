// RhymeLab's data model.
//
// The product surface is being rebuilt after the UX redesign. `Entry` is the
// first model back: a user's saved piece — the row the Library list renders.
// Add further models here, then run `pnpm db:migrate` to regenerate the client
// and the migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/_generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// A saved piece — a poem or a song's lyrics. Shape follows the api-contract's
/// `EntrySummarySchema`: `kind` discriminates the two, and `artist`/`album` are
/// present only for lyrics. Optional scalars are nullable; the list columns
/// (`author`/`artist`) record absence as `[]`. `userId` scopes every query — the app is moving toward multi-user,
/// and entries are always listed per user.
model Entry {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id")

  kind  String // "poem" | "lyrics"
  title String

  // Optional metadata. A piece can have several writers, so `author` is a list —
  // ordered, and empty when none was given (lists can't be NULL, so absence is
  // `[]` rather than NULL). `year` is nullable; NULL means "not provided".
  author String[] @default([])
  year   Int?

  // The full text as saved. The list view's excerpt / line count / word count
  // are derived from this on read (see the entries handler), not stored — so
  // they can never drift from the body they summarize.
  body String

  // One section label per body section, in order — the piece's structure. Its
  // length is held equal to the number of sections in `body` (blank-line-
  // separated blocks): a new piece defaults to one `verse` per section, and the
  // API re-syncs the array on every body edit, so the two can't drift. The
  // `@default([])` only fires for the create input's optional field; the write
  // path always supplies a correctly-sized array. See `structure` helpers in
  // `@rhymelab/api-contract`.
  structure String[] @default([])

  // Lyrics-only fields; empty / null for poems. `artist` is a list for the same
  // reason as `author` — a track can credit more than one performer.
  artist String[] @default([])
  album  String?

  // Both stamps are the database's to set, never the app's. Neither attribute
  // below achieves that on its own — `@updatedAt` is client-side outright, and
  // this generator resolves `@default(now())` client-side too, so the column
  // default never fires. A `BEFORE INSERT OR UPDATE` trigger is what actually
  // maintains them; see the `entry_updated_at_db_clock` migration. `@updatedAt`
  // is deliberately absent, and the `@default(now())`s survive only to keep the
  // fields optional in the generated create input — the trigger overwrites
  // whatever the client binds, and holds `createdAt` immutable across updates.
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  // Soft-delete tombstone: NULL means live, a timestamp means the user deleted
  // it. Every read path filters on `deletedAt: null` (see `EntryController`), so
  // a deleted piece disappears from the app while the row — and anything that
  // references it — survives, and the delete stays reversible.
  deletedAt DateTime? @map("deleted_at")

  @@index([kind])
  // The library lists one user's live entries, so the filter is (user, live) —
  // pairing the columns keeps that read on a single index as tombstones pile up.
  // This replaces the plain `[userId]` index rather than joining it: `userId` is
  // this one's leading column, so a lookup on it alone is served here too, and
  // keeping both would just cost a second b-tree update on every write.
  @@index([userId, deletedAt])
  @@map("entries")
}
