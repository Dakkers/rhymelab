{
  "name": "@rhymelab/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "prisma generate && tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@orpc/server": "1.14.5",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@rhymelab/api-contract": "workspace:*",
    "@rhymelab/fixtures": "workspace:*",
    "fastify": "^5.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "dotenv": "17.4.2",
    "prisma": "7.8.0",
    "tsx": "^4.20.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
