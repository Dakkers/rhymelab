{
  "name": "@rhymelab/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:db:seed": "tsx ./src/_dev/seed.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run --config .config/vitest.config.ts --project unit",
    "test:watch": "vitest --config .config/vitest.config.ts --project unit",
    "test:integration": "vitest run --config .config/vitest.config.ts --project integration --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@orpc/openapi": "1.14.5",
    "@orpc/server": "1.14.5",
    "@prisma/adapter-pg": "7.8.0",
    "@rhymelab/api-contract": "workspace:*",
    "@rhymelab/database": "workspace:*",
    "@rhymelab/fixtures": "workspace:*",
    "@rhymelab/utils": "workspace:*",
    "fastify": "5.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "dotenv": "17.4.2",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
