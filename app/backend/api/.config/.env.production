# Production defaults (committed — do NOT put secrets here).
#
# Loaded when NODE_ENV=production by src/load-env.ts, ahead of the shared
# `.env`. This is the same value src/session.ts checks to require a real
# SESSION_SECRET and set `secure` on the session cookie, so the config file and
# the hardening switch stay in step.
#
# Precedence: .env.production.local > .env.production > .env

NODE_ENV="production"
PORT="4000"

# The production web origin — CORS with credentials needs an exact origin.
# FRONTEND_ORIGIN="https://example.com"

# Secrets — never commit these. Provided by the host or .env.production.local:
# DATABASE_URL=
# SESSION_SECRET=
# APP_PASSWORD=
