# Development overrides (committed — do NOT put secrets here).
#
# Loaded when NODE_ENV=development (the default) by src/load-env.ts, ahead of
# the shared `.env`. Only put values here that differ from `.env`; anything the
# base file already sets correctly for local dev should stay there.
#
# Precedence: .env.development.local > .env.development > .env

NODE_ENV="development"
