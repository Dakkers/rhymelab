# Staging defaults (committed — do NOT put secrets here).
#
# Loaded when NODE_ENV=staging by src/load-env.ts, ahead of the shared `.env`.
# Real values for DATABASE_URL / SESSION_SECRET / APP_PASSWORD are secrets: set
# them in the host's environment (Render) or in .env.staging.local locally.
#
# Precedence: .env.staging.local > .env.staging > .env

NODE_ENV="staging"
PORT="4000"

# The staging web origin — CORS with credentials needs an exact origin, never "*".
# FRONTEND_ORIGIN="https://staging.example.com"

# Secrets — never commit these. Provided by the host or .env.staging.local:
# DATABASE_URL=
# SESSION_SECRET=
# APP_PASSWORD=
