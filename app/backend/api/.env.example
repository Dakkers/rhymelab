# Reference for the env files this package uses. Nothing loads *this* file —
# it's documentation plus a starting point to copy from.
#
# src/load-env.ts reads three files, highest priority first:
#
#   1. .env.<NODE_ENV>.local   gitignored — your real secrets live here
#   2. .env.<NODE_ENV>         committed  — non-secret per-environment defaults
#   3. .env                    committed  — non-secret defaults shared by all
#
# NODE_ENV defaults to "development", so a plain `pnpm dev` reads
# .env.development.local, then .env.development, then .env. The committed files
# already hold working local defaults, so the app runs with zero setup — you
# only need a .local file to override something.
#
# Note the loader does NOT read a bare `.env.local`; it's always suffixed with
# the environment. Use .env.development.local for local dev.
#
# Nothing overwrites a variable that's already set, so a value exported in your
# shell beats every file, and file 1 beats file 2 beats file 3.
#
# Which files exist:
#
#   COMMITTED (in git, never put a real secret in these)
#     .env                     shared defaults — see the file for what it sets
#     .env.development         NODE_ENV=development
#     .env.staging             NODE_ENV=staging
#     .env.production          NODE_ENV=production
#
#   GITIGNORED (not in a fresh clone — create the one you need by hand)
#     .env.development.local
#     .env.staging.local
#     .env.production.local
#
# In deployed environments prefer the host's own secret store (Render env vars)
# over shipping a .local file.

# ─── The variables, with copy-paste-ready dev values ─────────────────────────

# Local Postgres from the repo-root compose.yaml. Host port is 5433, not 5432 —
# it's remapped so it can't clash with another Postgres already on 5432.
DATABASE_URL="postgresql://rhymelab:rhymelab@localhost:5433/rhymelab"

# Fastify listen port.
PORT="4000"

# The web app's origin, used for CORS. Credentials mode needs an exact origin,
# never "*".
FRONTEND_ORIGIN="http://localhost:3000"

# Signs the session cookie. src/session.ts requires a real one (>= 32 chars)
# when NODE_ENV=production, and falls back to a dev default otherwise.
SESSION_SECRET="change-me-to-a-random-string-at-least-32-chars-long"

# The single shared password that unlocks the app.
APP_PASSWORD="password"
