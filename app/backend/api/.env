# Committed non-secret defaults for local dev. Real secrets go in .env.local
# (gitignored). NODE_ENV picks .env.<NODE_ENV>[.local] ahead of this file.

# Local Postgres from ../../../compose.yaml (host port 5433 -> container 5432,
# so it doesn't clash with any other Postgres already on 5432).
DATABASE_URL="postgresql://rhymelab:rhymelab@localhost:5433/rhymelab"

# Fastify listen port.
PORT="4000"

# The web app's dev origin — used for CORS (credentials mode needs an exact
# origin, never "*").
FRONTEND_ORIGIN="http://localhost:3000"

# Signs the session cookie. Fine as a dev default; override in .env.local for
# anything real (>= 32 chars).
SESSION_SECRET="dev-only-insecure-session-secret-change-me-0123456789"

# The single shared password that unlocks the app.
APP_PASSWORD="password"
