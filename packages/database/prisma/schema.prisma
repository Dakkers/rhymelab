generator client {
  provider            = "prisma-client"
  output              = "../src/_generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = ""
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../src/_generated/prisma-zod"
  config   = "../.config/prisma-to-zod.config.json"
}

datasource db {
  provider = "postgresql"
}

enum LyricEntryKind {
  poem
  song
}

enum LyricEntrySectionType {
  verse
  chorus
  bridge
  prechorus
  intro
  outro
  stanza
  postchorus
  refrain
  interlude
}

model User {
  id String @id @default(uuid()) @db.Uuid

  email        String @unique
  displayName  String @map("display_name")
  passwordHash String @map("password_hash")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  entries LyricEntry[]

  @@map("users")
}

model LyricEntry {
  id   String         @id @default(uuid()) @db.Uuid
  kind LyricEntryKind

  title     String
  body      String
  structure LyricEntrySectionType[] @default([])

  authors String[] @default([])
  year    Int?
  artists String[] @default([])
  album   String?
  isrc    String?
  iswc    String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  userId String @map("user_id") @db.Uuid

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  annotations LineAnnotation[]

  @@index([kind])
  @@index([userId, deletedAt])
  @@map("lyric_entries")
}

model LineAnnotation {
  entryId   String @map("entry_id") @db.Uuid
  lineIndex Int    @map("line_index")
  quote     String

  rhymeGroup Int?    @map("rhyme_group")
  enjambed   Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  entry LyricEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@id([entryId, lineIndex])
  @@index([entryId, rhymeGroup])
  @@map("line_annotations")
}
