generator client {
  provider            = "prisma-client"
  output              = "../src/_generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = ""
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../src/_generated/prisma-zod"
  config   = "../.config/prisma-to-zod.config.json"
}

datasource db {
  provider = "postgresql"
}

model Entry {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id")

  kind      String // "poem" | "song"
  title     String
  body      String
  structure String[] @default([])

  author String[] @default([])
  year   Int?
  artist String[] @default([]) // `song`-only
  album  String? // `song`-only

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  deletedAt DateTime? @map("deleted_at")

  @@index([kind])
  @@index([userId, deletedAt])
  @@map("entries")
}
