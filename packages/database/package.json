{
  "name": "@rhymelab/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas.ts"
  },
  "scripts": {
    "dev:db:reset": "prisma migrate reset",
    "postinstall": "pnpm build",
    "build": "prisma generate",
    "migrate": "prisma migrate dev",
    "studio": "prisma studio",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "dotenv": "17.4.2",
    "prisma": "7.8.0",
    "prisma-zod-generator": "3.3.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
