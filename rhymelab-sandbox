#!/usr/bin/env bash
# Credential-free, per-worktree sandbox. Run `./rhymelab-sandbox help`.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
min_major=22
min_minor=18

if ! command -v node >/dev/null 2>&1; then
  echo "error: node isn't installed. Install the version in $root/.nvmrc (nvm install) and retry." >&2
  exit 1
fi
IFS=. read -r major minor _ <<<"$(node -p 'process.versions.node')"
if [ "$major" -lt "$min_major" ] || { [ "$major" -eq "$min_major" ] && [ "$minor" -lt "$min_minor" ]; }; then
  echo "error: node $major.$minor can't run TypeScript natively; need >= $min_major.$min_minor. Run \`nvm install\` in $root." >&2
  exit 1
fi

exec node "$root/tools/sandbox/main.mts" "$@"
