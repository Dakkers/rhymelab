#!/usr/bin/env bash
#
# sandbox — spin up a full, isolated stack for the current worktree.
#
# The pain this solves: every worktree's `pnpm dev` points at the ONE shared
# Postgres (compose.yaml, host :5433, database "rhymelab"). Two worktrees editing
# data step on each other. `./rhymelab-sandbox` gives each worktree its own dedicated
# database inside that same container — `rhymelab_<worktree-slug>` — plus API and
# web servers on free ports, all wired together. Full data isolation, instant
# create/drop, negligible overhead (one shared Postgres server, many databases).
#
# Nothing is written to the worktree: the servers and `prisma migrate` read their
# config from exported env vars. dotenv (API + prisma.config.ts) never overrides
# an already-set var, and Vite's loadEnv applies process.env *after* .env files —
# so the values exported here win over the committed defaults, and `git status`
# stays clean.
#
#   ./rhymelab-sandbox            # up: provision + migrate the DB, then run API + web
#   ./rhymelab-sandbox up         # (same as no args)
#   ./rhymelab-sandbox status     # show this worktree's slug, database, ports
#   ./rhymelab-sandbox migrate    # ensure the DB exists and apply migrations (no servers)
#   ./rhymelab-sandbox reset      # drop + recreate + migrate (wipes this worktree's data)
#   ./rhymelab-sandbox down       # drop this worktree's database
#   ./rhymelab-sandbox psql       # open a psql shell on this worktree's database
#
# `down`/`reset` refuse to touch the shared default "rhymelab" database. Add
# --yes / -y to skip their confirmation prompt.

set -euo pipefail

# ── Constants (match compose.yaml) ───────────────────────────────────────────
PG_HOST="localhost"
PG_PORT="5433"
PG_USER="rhymelab"
PG_PASSWORD="rhymelab"
PG_SERVICE="postgres"              # docker-compose service name (create fallback)
PG_CONTAINER="rhymelab-postgres"  # fixed container_name in compose.yaml
PG_PROJECT="rhymelab"             # pin compose project so every worktree shares one container
DEFAULT_DB="rhymelab"             # the shared dev database; never dropped by this script

REPO_ROOT="$(git rev-parse --show-toplevel)"
# Resolve our own absolute path *before* cd'ing away, so `usage` can still read
# the script no matter how it was invoked (relative path, from a subdirectory…).
SCRIPT_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cd "$REPO_ROOT" # docker compose + pnpm workspace filters resolve from the root

# ── Derive a stable, Postgres-safe identity for this worktree ─────────────────
# Slug from the checkout's directory name: lowercased, non-alphanumerics folded
# to "_". Deterministic, so the same worktree always maps to the same database
# and ports across runs.
slugify() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/_/g; s/^_+//; s/_+$//'
}

slug="$(slugify "$(basename "$REPO_ROOT")")"

# Database name. The primary checkout (dir "rhymelab") keeps the shared default;
# worktrees named "rhymelab-<x>" become "rhymelab_<x>" without doubling the
# prefix; anything else is prefixed. Capped at Postgres's 63-char identifier max.
if [ "$slug" = "rhymelab" ]; then
  DB="$DEFAULT_DB"
elif [[ "$slug" == rhymelab_* ]]; then
  DB="$slug"
else
  DB="rhymelab_${slug}"
fi
# Postgres caps identifiers at 63 chars. Plain truncation would drop the unique
# hash worktree dirs carry at the *end*, silently merging two long branches into
# one database — so on overflow, append a hash of the full name to keep it unique.
if [ "${#DB}" -gt 63 ]; then
  db_hash="$(printf '%s' "$DB" | cksum | cut -d' ' -f1)"
  DB="${DB:0:$((62 - ${#db_hash}))}_${db_hash}"
fi

DB_URL="postgresql://${PG_USER}:${PG_PASSWORD}@${PG_HOST}:${PG_PORT}/${DB}"

# Runtime state (the actual bound ports + the `up` process's PID) lives OUTSIDE
# the worktree, keyed by slug, so `git status` stays clean. `status` and the `up`
# guard read it to report the real ports and detect whether *this* stack is live.
STATE_DIR="${TMPDIR:-/tmp}/rhymelab-sandbox"
STATE_FILE="${STATE_DIR}/${slug}.state"

# ── Port selection: deterministic base per slug ──────────────────────────────
# A per-slug offset spreads worktrees out so their preferred ports rarely clash.
# The bases are cheap to derive (no I/O); `up` scans up from them with free_port
# only when it actually needs to bind, and `status` reports them directly.
free_port() {
  local p="$1"
  while lsof -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1; do p=$((p + 1)); done
  printf '%s' "$p"
}
port_busy() { lsof -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }

port_offset="$(($(cksum <<<"$slug" | cut -d' ' -f1) % 50))"
WEB_BASE=$((3000 + port_offset))
API_BASE=$((4000 + port_offset))

# Load recorded state into SB_* (empty-init keeps `set -u` happy on a partial
# file); succeeds only when all three fields are present.
read_state() {
  SB_WEB_PORT=""
  SB_API_PORT=""
  SB_UP_PID=""
  [ -f "$STATE_FILE" ] || return 1
  # shellcheck disable=SC1090
  . "$STATE_FILE"
  [ -n "$SB_WEB_PORT" ] && [ -n "$SB_API_PORT" ] && [ -n "$SB_UP_PID" ]
}

# True only when *this* worktree's stack is actually live: the recorded up-process
# is still alive and its web port is listening — so stale state from a `kill -9`,
# or a reused PID, doesn't read as running.
sandbox_running() {
  read_state 2>/dev/null || return 1
  kill -0 "$SB_UP_PID" 2>/dev/null && port_busy "$SB_WEB_PORT"
}

# ── Postgres helpers ─────────────────────────────────────────────────────────
# The Postgres container is shared by every worktree, so we address it by its
# fixed container_name with plain `docker` — never through a per-directory
# `docker compose` project (that derives its name from the cwd and would try to
# spin up a *second* rhymelab-postgres, colliding on the fixed name). Compose is
# used only to *create* the container when it's missing, pinned to a constant
# project so all worktrees converge on the one instance.
# stderr is silenced so a stopped daemon surfaces as a clean "down", not a raw
# docker connection dump (callers that need Docker up go through ensure_pg).
pg_running() { [ -n "$(docker ps -q -f "name=^/${PG_CONTAINER}\$" -f status=running 2>/dev/null)" ]; }
pg_exists() { [ -n "$(docker ps -aq -f "name=^/${PG_CONTAINER}\$" 2>/dev/null)" ]; }

# Run psql against the maintenance "postgres" database as an admin, by container name.
psql_admin() {
  docker exec -i "$PG_CONTAINER" \
    psql -v ON_ERROR_STOP=1 -U "$PG_USER" -d postgres "$@"
}

db_exists() {
  local out
  out="$(psql_admin -tAc "SELECT 1 FROM pg_database WHERE datname = '${DB}'" 2>/dev/null || true)"
  [ "$out" = "1" ]
}

ensure_pg() {
  if ! docker info >/dev/null 2>&1; then
    echo "error: Docker isn't running. Start Docker/OrbStack and retry." >&2
    exit 1
  fi
  if pg_running; then
    : # already up — nothing to do
  elif pg_exists; then
    echo "Starting existing Postgres container…"
    docker start "$PG_CONTAINER" >/dev/null
  else
    echo "Creating Postgres container…"
    docker compose -p "$PG_PROJECT" up -d "$PG_SERVICE" >/dev/null
  fi
  local tries=0
  until docker exec "$PG_CONTAINER" pg_isready -U "$PG_USER" -d postgres >/dev/null 2>&1; do
    tries=$((tries + 1))
    if [ "$tries" -gt 30 ]; then
      echo "error: Postgres didn't become ready after 30s." >&2
      exit 1
    fi
    sleep 1
  done
}

ensure_db() {
  if db_exists; then return 0; fi
  echo "Creating database \"${DB}\"…"
  # Identifier is slug-derived (alphanumerics + underscore), so quoting it is safe.
  psql_admin -c "CREATE DATABASE \"${DB}\"" >/dev/null
}

run_migrations() {
  echo "Applying migrations to \"${DB}\"…"
  DATABASE_URL="$DB_URL" pnpm --filter @rhymelab/api exec prisma migrate deploy
  # Always regenerate, never just when `src/_generated/prisma` is missing (see
  # ensure_deps): a migration that adds a column leaves an *existing* client
  # stale, and every query touching that column then dies with a
  # PrismaClientValidationError at runtime. Generation is idempotent and takes
  # milliseconds, so paying it on every migrate is cheaper than the drift.
  echo "Regenerating Prisma client…"
  pnpm --filter @rhymelab/api db:generate
}

# Install deps if this is a fresh checkout. The Prisma client isn't generated
# here — run_migrations always does it, and every caller of this runs that next.
ensure_deps() {
  if [ ! -d "node_modules" ]; then
    echo "Installing dependencies (fresh worktree)…"
    pnpm install
  fi
}

confirm_destructive() {
  # $1 = action description. Refuses the shared default DB outright; otherwise
  # prompts unless --yes was passed.
  if [ "$DB" = "$DEFAULT_DB" ]; then
    echo "refusing to $1 the shared default database \"$DEFAULT_DB\"." >&2
    echo "Sandboxes are per-worktree; run this from a worktree, not the primary checkout." >&2
    exit 1
  fi
  if [ "${ASSUME_YES:-0}" = "1" ]; then return 0; fi
  # `read` fails at EOF (piped / no TTY). Treat that like a declined prompt and
  # abort with a message, rather than letting `set -e` kill us silently.
  local ans
  if ! read -r -p "About to $1 database \"$DB\". Continue? [y/N] " ans; then
    echo "Aborted (no input)." >&2
    exit 1
  fi
  case "$ans" in
    [yY] | [yY][eE][sS]) return 0 ;;
    *) echo "Aborted."; exit 1 ;;
  esac
}

# ── Subcommands ──────────────────────────────────────────────────────────────
cmd_status() {
  local db_state pg_state api_line web_line
  if pg_running; then
    pg_state="up"
    if db_exists; then db_state="present"; else db_state="not created"; fi
  else
    pg_state="down"
    db_state="unknown (postgres down)" # don't assert a state we couldn't check
  fi

  # Report the *actual* bound ports when this stack is live (up may have scanned
  # past an occupied base); otherwise show the preferred base ports up will try,
  # flagging a base already held by some other process.
  if sandbox_running; then
    api_line="http://localhost:${SB_API_PORT}/api (listening)"
    web_line="http://localhost:${SB_WEB_PORT} (listening)"
  else
    api_line="http://localhost:${API_BASE}/api ($(port_busy "$API_BASE" && echo 'busy (other process)' || echo free))"
    web_line="http://localhost:${WEB_BASE} ($(port_busy "$WEB_BASE" && echo 'busy (other process)' || echo free))"
  fi

  echo "worktree : $REPO_ROOT"
  echo "slug     : $slug"
  echo "postgres : container rhymelab-postgres ($pg_state) @ ${PG_HOST}:${PG_PORT}"
  echo "database : $DB ($db_state)"
  echo "db url   : $DB_URL"
  echo "api      : $api_line"
  echo "web      : $web_line"
}

cmd_migrate() {
  ensure_deps # cold checkouts need node_modules before `prisma` is on the path
  ensure_pg
  ensure_db
  run_migrations
}

cmd_reset() {
  confirm_destructive "wipe and recreate"
  ensure_pg
  echo "Dropping database \"${DB}\"…"
  psql_admin -c "DROP DATABASE IF EXISTS \"${DB}\" WITH (FORCE)" >/dev/null
  ensure_db
  run_migrations
  echo "Reset complete — \"${DB}\" is empty and migrated."
}

cmd_down() {
  confirm_destructive "drop"
  ensure_pg
  echo "Dropping database \"${DB}\"…"
  psql_admin -c "DROP DATABASE IF EXISTS \"${DB}\" WITH (FORCE)" >/dev/null
  echo "Dropped \"${DB}\". Servers, if running, are separate — stop them with Ctrl-C."
}

cmd_psql() {
  ensure_pg
  if ! db_exists; then
    echo "error: database \"$DB\" doesn't exist yet. Run \`./rhymelab-sandbox migrate\` first." >&2
    exit 1
  fi
  docker exec -it "$PG_CONTAINER" psql -U "$PG_USER" -d "$DB"
}

cmd_up() {
  # Refuse to start a second copy of *this* worktree's stack. Keyed on our own
  # recorded state (up-process alive + its web port live), so a different worktree
  # that merely shares a port offset never trips this — free_port routes it away.
  if sandbox_running; then
    echo "This worktree's sandbox is already running:" >&2
    echo "  web  http://localhost:${SB_WEB_PORT}" >&2
    echo "  api  http://localhost:${SB_API_PORT}/api" >&2
    echo "Stop it first (Ctrl-C in its terminal) before starting another." >&2
    exit 1
  fi

  ensure_deps
  ensure_pg
  ensure_db
  run_migrations

  # Pick ports as late as possible — right before binding — so the gap between
  # "free_port saw it free" and "the server bound it" is milliseconds, not the
  # whole install+migrate above (which would let a concurrent worktree grab them).
  local WEB_PORT API_PORT
  WEB_PORT="$(free_port "$WEB_BASE")"
  API_PORT="$(free_port "$API_BASE")"

  cat <<BANNER

  ┌─ RhymeLab sandbox ────────────────────────────────────────
  │ worktree : $slug
  │ database : $DB (isolated)
  │ web      : http://localhost:${WEB_PORT}
  │ api      : http://localhost:${API_PORT}/api
  │
  │ Ctrl-C stops both servers. The database persists — drop it
  │ with \`./rhymelab-sandbox down\` when you're done with this worktree.
  └───────────────────────────────────────────────────────────

BANNER

  # Wire both servers via exported env. dotenv (API + prisma) and Vite all defer
  # to an already-set var, so these override the committed :4000/:3000/rhymelab
  # defaults without touching a file.
  export DATABASE_URL="$DB_URL"
  export PORT="$API_PORT"
  export FRONTEND_ORIGIN="http://localhost:${WEB_PORT}"
  export VITE_API_URL="http://localhost:${API_PORT}/api"

  # Record the real ports + our PID so `status` and the guard see the live stack.
  mkdir -p "$STATE_DIR"
  printf 'SB_WEB_PORT=%s\nSB_API_PORT=%s\nSB_UP_PID=%s\n' "$WEB_PORT" "$API_PORT" "$$" >"$STATE_FILE"

  # Job control (set -m) puts each server in its own process group, so we can
  # signal the whole group on shutdown — reaping pnpm's grandchildren (tsx, vite)
  # too, not just the pnpm wrapper.
  set -m
  local pids=()
  cleanup() {
    rm -f "$STATE_FILE"
    local pid
    for pid in ${pids[@]+"${pids[@]}"}; do
      kill -TERM "-${pid}" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    done
    wait 2>/dev/null || true
  }
  trap cleanup EXIT
  trap 'echo; echo "Stopping sandbox servers…"; exit 0' INT TERM

  pnpm --filter @rhymelab/api dev &
  pids+=($!)
  pnpm --filter @rhymelab/web exec \
    vite dev --config .config/vite.config.ts --port "$WEB_PORT" --strictPort &
  pids+=($!)

  # A bare `wait` blocks until *all* children exit, so a server that dies at
  # startup would hang the script on the survivor with no signal. Poll both and
  # bail the moment either exits (bash 3.2 has no `wait -n`); the EXIT trap tears
  # the rest down and clears state.
  while kill -0 "${pids[0]}" 2>/dev/null && kill -0 "${pids[1]}" 2>/dev/null; do
    sleep 1
  done
  echo "A sandbox server exited unexpectedly — shutting down the rest." >&2
  exit 1
}

usage() {
  # Print the leading comment block (skip the shebang, stop at the first line of
  # code), stripping the "# " prefix.
  awk 'NR==1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$SCRIPT_PATH"
}

case "${1:-up}" in
  up | "") cmd_up ;;
  status) cmd_status ;;
  migrate) cmd_migrate ;;
  reset)
    shift || true
    [[ "${1:-}" == "-y" || "${1:-}" == "--yes" ]] && ASSUME_YES=1
    cmd_reset
    ;;
  down)
    shift || true
    [[ "${1:-}" == "-y" || "${1:-}" == "--yes" ]] && ASSUME_YES=1
    cmd_down
    ;;
  psql) cmd_psql ;;
  -h | --help | help) usage ;;
  *)
    echo "unknown command: $1" >&2
    echo "run \`./rhymelab-sandbox help\` for usage." >&2
    exit 1
    ;;
esac
