# Dependencies
node_modules/

# Build outputs
dist/
dist-ssr/
build/
.output/
.nitro/
.tanstack/

# Cloudflare / Wrangler
.wrangler/
.dev.vars
# Generated by `wrangler types` — regenerate locally, never commit.
worker-configuration.d.ts

# TypeScript
*.tsbuildinfo

# Environment (only *.local files are secret; committed .env files hold
# non-secret defaults)
.env.local
.env.*.local

# Vite
.vite/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Test coverage
coverage/

# Playwright (E2E) — local run artifacts; saved auth state is ignored next to it
test-results/
playwright-report/
.last-run.json

# Scratch space — tracked as an empty dir via .gitkeep
.dummy/*
!.dummy/.gitkeep

# Out-of-band DB backups (e.g. the pre-migration annotations dump). Never commit
# real data; keep the local copy until the migration it guards is retired.
.backups/
